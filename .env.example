# Local development only. Generate unique values; never commit the populated .env file.
POLARIS_ENVIRONMENT=development
POLARIS_JWT_ISSUER=https://identity.northstar.example.test
POLARIS_JWT_AUDIENCE=polaris-api
POLARIS_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
POLARIS_AUDIT_HMAC_KEY=replace-with-a-different-32-character-random-key
POLARIS_APPROVAL_HMAC_KEY=replace-with-a-third-distinct-32-character-key
POLARIS_ACTION_TTL_SECONDS=300
